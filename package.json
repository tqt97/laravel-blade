{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:stripe": "stripe listen --forward-to http://127.0.0.1:8000/webhooks/stripe",
        "dev:stack": "concurrently --kill-others-on-fail --names app,stripe \"php artisan dev\" \"npm run dev:stripe\"",
        "lint": "eslint resources/js",
        "test:frontend": "node --test tests/frontend/*.test.js",
        "test:e2e": "playwright test",
        "check": "npm run lint && npm run build"
    },
    "devDependencies": {
        "@playwright/test": "^1.63.0",
        "@tailwindcss/vite": "^4.0.0",
        "concurrently": "^10.0.3",
        "eslint": "^9.39.5",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
