  "cards": [
    {
      "dot": "cyan",
      "title": "Booking invariants",
      "items": [
        "ScreeningSeat is the inventory source of truth",
        "Mutations use actions, transactions, row locks, and idempotency keys",
        "Prices are snapshotted in minor currency units"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "Client selection, hidden prices, and payment redirects are untrusted",
        "Admin routes require auth plus can:admin.access",
        "Stripe webhooks bypass CSRF but require signature and event idempotency"
      ]
    },
    {
      "dot": "emerald",
      "title": "Reliability",
      "items": [
        "Outbox dispatch occurs after commit",
        "Workers retry deliveries with leases and idempotency keys",
        "Scheduler expires holds and reconciles uncertain payments"
      ]
    }
